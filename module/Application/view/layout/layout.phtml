            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1199;
            opacity: 0;
            visibility: hidden;
            transition: var(--transition);
        }
        
        .settings-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        .settings-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }
        
        .theme-options {
            display: grid;
