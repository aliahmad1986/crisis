        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .animate-card {
            animation: fadeInUp 0.6s ease-out;
        }
        
        /* Toast Notification - RTL Position */
        .toast-notification {
            position: fixed;
            bottom: 20px;
